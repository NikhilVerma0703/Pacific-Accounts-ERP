# Local SQLite file — no database server, no Docker.
# `npx prisma db push` creates it.
DATABASE_URL="file:./dev.db"

# Company identity — used only to tell "our side" from the customer side,
# and to decide Export vs Domestic. Never used to invent data.
HOME_CURRENCY="INR"
HOME_COUNTRY="INDIA"

# Register-wide jobs (recalculate after a rule change, re-extract everything).
# false  -> run them inline in the request. Nothing else to start. Default.
# true   -> hand them to Inngest (run `npm run inngest:dev` in another terminal).
USE_INNGEST="false"

# The Commercial ERP sync endpoint (/api/commercial/sync) stays refused until
# this is "true". The integration is not built; this switch exists so the
# endpoint cannot be reached before it has authentication.
COMMERCIAL_ERP_SYNC="false"
